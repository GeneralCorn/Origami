{
  "name": "origami-desktop",
  "productName": "Origami",
  "version": "0.1.0",
  "private": true,
  "description": "Origami desktop shell: Electron around the Vite renderer with the Python backend as a sidecar",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "npm run build:main && node scripts/dev.mjs",
    "build": "npm run build:main && npm run typecheck && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "typecheck": "tsc -p tsconfig.json",
    "start": "electron .",
    "smoke": "npm run build:main && electron . --smoke-test",
    "bundle:python": "node scripts/bundle-python.mjs",
    "package": "electron-forge package",
    "make": "electron-forge make"
  },
  "dependencies": {
    "@ai-sdk/react": "^3.0.99",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@uiw/react-markdown-preview": "^5.2.1",
    "@uiw/react-md-editor": "^4.0.11",
    "ai": "^6.0.97",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "katex": "^0.16.33",
    "lucide-react": "^0.575.0",
    "motion": "^12.34.3",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-dropzone": "^15.0.0",
    "react-resizable-panels": "^4",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron/notarize": "^2.5.0",
    "@electron/osx-sign": "^1.3.3",
    "@tailwindcss/vite": "^4",
    "@types/katex": "^0.16.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^43.2.0",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vite": "^7.3.6"
  }
}
