<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements for the Electron binaries: Origami itself and the four
  helper apps. Every key here is present because something breaks without
  it under the hardened runtime, which notarization requires.

  allow-jit          V8 compiles JavaScript at runtime. Without it the
                     renderer cannot map executable pages and Chromium
                     aborts on startup.

  The App Sandbox is deliberately not enabled: the backend reads and
  writes a user-chosen knowledge base, and the local sources in the
  integrations matrix are outside any container.
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
  </dict>
</plist>
