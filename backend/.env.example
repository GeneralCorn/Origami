# Copy this file to .env.local and adjust values for your setup.
#   cp .env.example .env.local

# Data root — all backend data dirs (chroma, uploads, pdfs, chats,
# notes, screenshots, digests, models) resolve under this. Leave unset
# to keep the historical layout inside backend/.
# ORIGAMI_DATA_DIR=/absolute/path/to/data

# Server bind address. ORIGAMI_PORT=0 asks the OS for a free port;
# `python main.py` prints the bound port as ORIGAMI_PORT=<n> on stdout.
ORIGAMI_HOST=127.0.0.1
ORIGAMI_PORT=8000

# Anthropic (agent + ingestion LLM)
ANTHROPIC_API_KEY=sk-ant-...
HAIKU_MODEL=claude-haiku-4-5-20251001
SONNET_MODEL=claude-sonnet-4-6

# Ollama (for VLMs)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:8b
OLLAMA_VLM_MODEL=qwen2.5-vl:7b
OLLAMA_TIMEOUT=120

# Embeddings (must re-ingest docs if changed)
EMBEDDING_MODEL=bge-small-en-v1.5

# ChromaDB
CHROMA_DIR=chroma_data
CHROMA_COLLECTION=documents

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:3000

# Extra CORS origins, comma-separated (used by the Electron shell)
# ORIGAMI_ALLOWED_ORIGINS=http://localhost:5173,null

# Ingestion
CHUNK_SIZE=1200
CHUNK_OVERLAP=300
